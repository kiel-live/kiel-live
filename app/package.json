{
  "name": "@kiel-live/app",
  "author": "Kiel-Live Team",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "VITE_BUILD_DATE=$(date '+%d.%m.%Y %H:%M:%S') vite",
    "build": "VITE_BUILD_DATE=$(date '+%d.%m.%Y %H:%M:%S') vite build",
    "build:test": "VITE_BUILD_DATE='01.01.1970 00:00:00' vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0 .",
    "formatcheck": "prettier -c .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "docker run --rm -it -v $(pwd):/app --network=host mcr.microsoft.com/playwright:v1.58.2 bash -c \"npm i -g corepack && cd /app && pnpm run test:e2e -u\" && sudo chown -R $USER:$USER tests test-results dist",
    "translate": "pnpx @geprog/translator translate ./src/locales"
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "@vueuse/core": "14.4.0",
    "canvas-confetti": "1.9.4",
    "fuse.js": "7.5.0",
    "maplibre-gl": "5.24.0",
    "micromark": "4.0.2",
    "vue": "3.5.41",
    "vue-i18n": "11.4.10",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.3.0",
    "@eslint/js": "10.0.1",
    "@iconify-json/carbon": "1.2.25",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/ph": "1.2.2",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@intlify/unplugin-vue-i18n": "11.2.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.9.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue-scoped-css": "3.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.1.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "yaml-eslint-parser": "1.3.2"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
